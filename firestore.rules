rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      let email = request.auth.token.get('email', '');
      return isSignedIn() && (
        email.lower() == 'cloudkiss90@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isManager() {
      let email = request.auth.token.get('email', '');
      return isSignedIn() && (
        isSuperAdmin() ||
        email.lower() == 'spkgase@spk.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager')
      );
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isManager();
      allow create: if isSignedIn() && (userId == request.auth.uid || isSuperAdmin());
      allow update: if isSignedIn() && (userId == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /applications/{appId} {
      // Anyone signed in can apply
      allow create: if isSignedIn();
      
      // Anyone signed in can read (for list view)
      allow read: if isSignedIn(); 
      
      // Managers can update (approve/reject). 
      // Applicants can also "cancel" by setting status to 'rejected' IF currently pending (optional)
      allow update: if isManager(); 
      
      // Managers can delete. Applicants can delete their own applications if still pending.
      allow delete: if isManager() || (isSignedIn() && resource.data.applicantId == request.auth.uid && resource.data.status == 'pending');
    }

    match /credentials/{credId} {
      // Allow get/read for anyone signed in (needed during login process to verify passwords)
      allow read: if isSignedIn();
      // Only super admins can manage these credentials (list/create/etc)
      allow list, create, update, delete: if isSuperAdmin();
    }
  }
}
